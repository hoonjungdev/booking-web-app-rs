{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, kind, booking_id, status, attempts, max_attempts, run_at, locked_until,\n               last_error, payload, provider_id, sent_at, created_at, updated_at\n        FROM jobs\n        WHERE status = 'dead'\n          AND ($1::text IS NULL OR kind = $1)\n          AND ($2::int8 IS NULL OR id < $2)\n        ORDER BY id DESC\n        LIMIT $3\n        ",
