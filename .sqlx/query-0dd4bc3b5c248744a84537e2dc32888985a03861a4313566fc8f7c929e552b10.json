  "query": "\n        SELECT kind,\n               count(*) FILTER (WHERE status = 'queued') AS \"ready!\",\n               count(*) FILTER (WHERE status = 'dead')   AS \"dead!\"\n        FROM jobs\n        WHERE (status = 'queued' AND run_at <= now()) OR status = 'dead'\n        GROUP BY kind\n        ",
