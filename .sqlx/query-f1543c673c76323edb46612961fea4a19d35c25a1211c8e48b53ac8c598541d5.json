{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n          date_bin(make_interval(secs => $4), started_at, '2000-01-01T00:00:00Z'::timestamptz) AS \"bucket!\",\n          outcome,\n          count(*) AS \"count!\"\n        FROM provider_calls\n        WHERE provider_id = $1 AND started_at >= $2 AND started_at < $3\n        GROUP BY 1, 2\n        ORDER BY 1, 2\n        ",
