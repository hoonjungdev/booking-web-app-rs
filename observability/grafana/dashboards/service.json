          "editorMode": "code",
          "expr": "1 - (sum(increase(http_server_request_duration_seconds_count{job=\"booking-server\", http_route=~\"/v1/.+\", http_response_status_code=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_server_request_duration_seconds_count{job=\"booking-server\", http_route=~\"/v1/.+\"}[$__range]))",
