    {
      "type": "stat",
      "title": "예약 API 가용성 (선택한 기간)",
      "description": "예약 API(/v1) 응답 중 5xx가 아닌 비율. SLO: 99.9% 이상. 관리자 API(/admin/api)와 헬스 체크는 넣지 않는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
