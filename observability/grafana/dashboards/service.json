    {
      "type": "timeseries",
      "title": "오류 비율 (4xx · 5xx · 응답 없음)",
      "description": "mock-provider의 5xx는 주입한 장애(chaos)다.\n\n'응답 없음'은 응답을 보내기 전에 끝난 요청이다 (호출한 쪽이 기다리다 먼저 끊음). slow · lossy 프리셋에서 booking-server가 3초 타임아웃으로 끊으면 mock-provider 쪽에 나타난다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "min": 0,
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\", http_response_status_code=~\"5..\"}[1m]) or rate(http_server_request_duration_seconds_count{job=~\"$job\"}[1m]) * 0) / sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\"}[1m]))",
          "legendFormat": "{{job}} 5xx",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\", http_response_status_code=~\"4..\"}[1m]) or rate(http_server_request_duration_seconds_count{job=~\"$job\"}[1m]) * 0) / sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\"}[1m]))",
          "legendFormat": "{{job}} 4xx",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\", error_type=\"no_response\"}[1m]) or rate(http_server_request_duration_seconds_count{job=~\"$job\"}[1m]) * 0) / sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\"}[1m]))",
          "legendFormat": "{{job}} 응답 없음",
          "refId": "C",
          "range": true
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      }
    },
