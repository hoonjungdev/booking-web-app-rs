# 로컬 개발용 환경 변수 예시. `cp .env.example .env`로 복사해서 쓴다 (.env는 커밋하지 않는다).
# booking-server, sqlx CLI, sqlx 매크로가 모두 .env를 읽는다.

# docker compose의 PostgreSQL
DATABASE_URL=postgres://booking:booking@127.0.0.1:5432/booking

# booking-server 설정 (기본값을 바꿀 때만 주석을 푼다)
# BOOKING_LISTEN_ADDR=127.0.0.1:8080
# BOOKING_DB_MAX_CONNECTIONS=10
# BOOKING_WORKER_CONCURRENCY=4
# BOOKING_WORKER_POLL_INTERVAL_MS=500
# BOOKING_WORKER_LEASE_SECS=60          # 업체 호출 최대 시간(기본 정책이면 약 16초) + 5초 이상
# BOOKING_WORKER_UNKNOWN_RECHECK_SECS=30

# 로그
# RUST_LOG=info,booking_server=debug
# LOG_FORMAT=json
